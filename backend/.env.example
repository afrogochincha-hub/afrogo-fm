# Copia este archivo como .env en el servidor. Nunca lo subas a GitHub.
PORT=8787
NODE_ENV=production

# URL pública HTTPS del gateway de Afrogo, después de configurar un dominio y TLS.
# Ejemplo: https://api.tudominio.com
PUBLIC_API_BASE_URL=https://afrogochincha.duckdns.org/afrogo-api

# AzuraCast; BASE_URL es la raíz de la instalación, no /public/afrogo-fm.
AZURACAST_BASE_URL=http://129.153.179.138
# ID verificado con la API pública y la respuesta GET /api/station/1/files.
AZURACAST_STATION_ID=1
AZURACAST_API_KEY=PEGAR_AQUI_LA_NUEVA_CLAVE_API
# Desactivado por seguridad. Solo activa tras actualizar AzuraCast a una versión parcheada y verificar la API de tu instalación.
AZURACAST_UPLOAD_ENABLED=false

# Genera secretos largos y únicos. No compartas estos valores ni los versionas.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
BOOTSTRAP_ADMIN_EMAIL=tu-correo-administrador@ejemplo.com
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
DATA_DIR=./data
