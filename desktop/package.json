{
  "name": "afrogo-fm",
  "version": "3.30.0",
  "description": "Afrogo FM con biblioteca personal en la nube: playlists, favoritos e historial sincronizados",
  "main": "main.js",
  "author": "Afrogo FM",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "check": "node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afrogo.fm",
    "productName": "Afrogo FM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json",
      "app-config.json",
      "afrogo-icon.png",
      "afrogo-icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "afrogo-icon.ico"
    }
  },
  "dependencies": {
    "music-metadata": "^10.7.0"
  }
}
